{
  "name": "Discord用 動画圧縮",
  "short_name": "動画圧縮",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1e1f22",
  "theme_color": "#5865F2",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "video", "accept": ["video/*"] }]
    }
  }
}
